# Локальные значения. Секреты сюда не записывайте.
# TELEGRAM_BOT_TOKEN читается только из окружения (Cursor Runtime Secret).
# Если переменная пустая, остаётся тестовый адаптер и бот не подключается к Telegram.
APP_ENV=local
DATABASE_URL=postgresql+psycopg://hr:hr@localhost:5432/hr
JWT_SECRET=local-only-not-for-production
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-local-only
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=magripaharip_bot
# Числовой id супергруппы. Ссылку-приглашение в репозиторий не кладём.
CORPORATE_CHAT_ID=-1002615527142
SUPER_ADMIN_TELEGRAM_USERNAME=Kapanov_30
# Живой провайдер — OpenAI. Ключ читается только из OPENAI_API_KEY.
# Пустое значение оставляет тестовый адаптер, запросов к API нет.
# Имя модели задаётся в настройках организации и секретом не является.
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
# Ключ Notion читается только из NOTION_API_KEY. Пустое значение не вызывает Notion.
# ID базы — настройка организации, не секрет и не эта переменная.
NOTION_API_KEY=
CORS_ORIGINS=http://localhost:3000
WORKER_INTERVAL_SECONDS=30
TELEGRAM_SEND_INTERVAL_SECONDS=0.05
TELEGRAM_MAX_ATTEMPTS=3
